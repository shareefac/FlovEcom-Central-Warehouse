#!/usr/bin/env bash
# cw-deploy-stub
# curl ... https://NAME/v1/health or https://NAME/ui/login (tests/Unit/ProfitUndoScriptsBehaviourTest.php): undo B's probes through the
# local listener (as deploy/production/enable_https.sh checks them). Prints the HTTP code, as curl's -w '%{http_code}' does: 000 and
# exit 7 (no connection) while Apache is not running (state/apache) or the public vhost is not enabled (state/site_cw-https); else, per
# call of that address, the next line of answers/health_codes (default 401: the API without a key) or answers/login_codes (default 200:
# the sign-in page), and exits with the next line of answers/health_exits or answers/login_exits (default 0; e.g. 28: a timeout after
# the headers, the code already printed). The last line of a list is kept once the list is used up. Any other address: exit 7.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib.sh"
url=${!#}
log "curl $*"
case $url in
    https://*/v1/health) kind=health; default=401 ;;
    https://*/ui/login) kind=login; default=200 ;;
    *) exit 7 ;;
esac
if [[ $(cat "$S/apache" 2>/dev/null || echo active) != active || ! -e $S/site_cw-https ]]; then
    printf 000
    exit 7
fi
n=$(( $(cat "$S/${kind}_calls" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$S/${kind}_calls"
# nth LIST DEFAULT: line n of the list (its last line once used up), or the default
nth() {
    local list line
    list=$(answer "$1" "$2")
    line=$(sed -n "${n}p" <<<"$list")
    [[ -n $line ]] || line=$(tail -n 1 <<<"$list")
    printf '%s' "$line"
}
printf '%s' "$(nth "${kind}_codes" "$default")"
exit "$(nth "${kind}_exits" 0)"
