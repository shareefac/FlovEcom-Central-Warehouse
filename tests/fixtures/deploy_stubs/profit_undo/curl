#!/usr/bin/env bash
# cw-deploy-stub
# curl ... https://NAME/v1/health (tests/Unit/ProfitUndoScriptsBehaviourTest.php): undo B's probe of the API through the local listener
# (as deploy/production/enable_https.sh checks it). Prints the HTTP code, as curl's -w '%{http_code}' does: 000 and exit 7 (no
# connection) while Apache is not running (state/apache) or the public vhost is not enabled (state/site_cw-https); else the next line
# of answers/health_codes, one per call (the last line once they are used up; default 401: the API without a key). Any other URL:
# exit 7.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib.sh"
url=${!#}
log "curl $*"
[[ $url == https://*/v1/health ]] || exit 7
if [[ $(cat "$S/apache" 2>/dev/null || echo active) != active || ! -e $S/site_cw-https ]]; then
    printf 000
    exit 7
fi
n=$(( $(cat "$S/health_calls" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$S/health_calls"
codes=$(answer health_codes 401)
code=$(sed -n "${n}p" <<<"$codes")
[[ -n $code ]] || code=$(tail -n 1 <<<"$codes")
printf '%s' "$code"
