#!/usr/bin/env bash
# cw-deploy-stub
# install -m MODE -o USER -g GROUP SRC DEST (tests/Unit/ProfitUndoScriptsBehaviourTest.php): SRC copied to DEST with MODE, as install(1)
# does; the owner and the group are recorded only (the test needs no root). A SRC that is not there fails, as install(1) does.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib.sh"
log "install $*"
mode=0755
files=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -m) mode=$2; shift 2 ;;
        -o|-g) shift 2 ;;
        -*) echo "install stub: $1 is not known" >&2; exit 99 ;;
        *) files+=("$1"); shift ;;
    esac
done
[[ ${#files[@]} -eq 2 ]] || { echo "install stub: only install [-m -o -g] SRC DEST" >&2; exit 99; }
[[ -f ${files[0]} ]] || { echo "install: cannot stat '${files[0]#"$R"}': No such file or directory" >&2; exit 1; }
cp "${files[0]}" "${files[1]}.stub-install"
chmod "$mode" "${files[1]}.stub-install"
mv -f "${files[1]}.stub-install" "${files[1]}"
