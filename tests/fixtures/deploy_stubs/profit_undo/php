#!/usr/bin/env bash
# cw-deploy-stub
# php SCRIPT ARGS (tests/Unit/ProfitUndoScriptsBehaviourTest.php), recorded with the release it ran from (the script's directory
# resolved, or the working directory for a relative script; the tree's prefix taken off): bin/migrate.php --status prints
# answers/migrate_status (default: 0074 and 0075 applied) and exits answers/migrate_status_exit (default 0); any other bin/NAME.php
# prints a line and exits answers/NAME.exit (default 0). No database, no PHP is run.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib.sh"
script=${1-}
[[ $script == */bin/*.php || $script == bin/*.php ]] || { echo "php stub: only php [DIR/]bin/NAME.php ARGS" >&2; exit 99; }
where=$(readlink -f "$(dirname "$script")/..")
log "php $* (release $where)"
name=${script##*/}
if [[ $name == migrate.php && " ${*:2} " == *' --status '* ]]; then
    answer migrate_status "0074_profit.sql                          applied 2026-11-21 06:00:01
0075_profit_queue.sql                    applied 2026-11-21 06:00:02"
    echo
    exit "$(answer migrate_status_exit 0)"
fi
echo "$name: ok"
exit "$(answer "$name.exit" 0)"
