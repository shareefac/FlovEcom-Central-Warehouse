#!/usr/bin/env bash
# cw-deploy-stub
# certbot certonly ... -d NAME: puts a certificate at etc/letsencrypt/live/NAME/fullchain.pem in the tree.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib.sh"
log "certbot $*"
name=
while [[ $# -gt 0 ]]; do
    [[ $1 == -d ]] && name=${2-}
    shift
done
[[ -n $name ]] || { echo "certbot stub: no -d" >&2; exit 1; }
mkdir -p "$R/etc/letsencrypt/live/$name"
echo certificate > "$R/etc/letsencrypt/live/$name/fullchain.pem"
