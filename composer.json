{
    "name": "tabsyst/central-warehouse",
    "description": "Central Warehouse (CW): shared stock, reservations and catalogue links for the Vape and Go, Vape Big and Electrofag storefronts.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "anthropic-ai/sdk": "^1.14",
        "bacon/bacon-qr-code": "^3.1",
        "guzzlehttp/guzzle": "^7.9",
        "openspout/openspout": "^4.32",
        "setasign/fpdf": "1.8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "CW\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CW\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": false,
        "platform-check": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
